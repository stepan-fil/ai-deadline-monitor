      "parameters": {
        "respondWith": "text",
        "responseBody": "<!DOCTYPE html>\n<html lang=\"de\">\n<head>\n<meta charset=\"utf-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n<title>Fristen-Übersicht — Freigegeben (Externe Ansicht)</title>\n<style>\n  :root{\n    --bg-1:#07130f; --bg-2:#0c1f18;\n    --panel:#ffffff; --panel-2:#f6fbf8;\n    --ink:#0f172a; --ink-2:#334155; --muted:#64748b; --line:#e6eaf0;\n    --green:#0f766e; --green-bg:#ecfdf5;\n    --gruen:#15803d; --gelb:#b45309; --rot:#be123c;\n    --gruen-bg:#f0fdf4; --gelb-bg:#fffbeb; --rot-bg:#fff1f2;\n    --shadow:0 14px 40px -12px rgba(6,20,15,.45);\n    --r-card:18px; --r-md:11px;\n    --ease:cubic-bezier(.22,.61,.36,1);\n    --sans:-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif;\n  }\n  *{box-sizing:border-box}\n  body{\n    margin:0; font-family:var(--sans); color:var(--ink);\n    background:radial-gradient(1200px 600px at 70% -10%, #12342a 0, var(--bg-1) 60%), var(--bg-1);\n    min-height:100dvh; padding:34px 26px 56px; -webkit-font-smoothing:antialiased;\n  }\n  .wrap{max-width:1180px; margin:0 auto}\n\n  header{display:flex; align-items:flex-end; justify-content:space-between; gap:24px; flex-wrap:wrap; margin-bottom:16px}\n  .badge{display:inline-flex; align-items:center; gap:8px; font-size:11.5px; font-weight:700; letter-spacing:.6px;\n    text-transform:uppercase; color:#d1fae5; background:rgba(16,185,129,.14); border:1px solid rgba(16,185,129,.35);\n    padding:6px 12px; border-radius:999px; margin-bottom:11px}\n  .badge .lock{font-size:12px}\n  h1{font-size:28px; font-weight:600; letter-spacing:-.5px; margin:0 0 6px; color:#fff}\n  .sub{color:#9ec8ba; font-size:14.5px; max-width:64ch; line-height:1.5}\n  .sub b{color:#d7efe6; font-weight:600}\n  .status{display:flex; align-items:center; gap:18px; font-size:13px; color:#8fb6a8; white-space:nowrap}\n  .status .k{color:#5f8576}\n  .status b{color:#dcfce7; font-weight:600; font-variant-numeric:tabular-nums}\n  .live{display:flex; align-items:center; gap:7px}\n  .dot{width:8px; height:8px; border-radius:50%; background:#22c55e; box-shadow:0 0 0 0 rgba(34,197,94,.7); animation:pulse 2s infinite}\n  @keyframes pulse{70%{box-shadow:0 0 0 8px rgba(34,197,94,0)}100%{box-shadow:0 0 0 0 rgba(34,197,94,0)}}\n\n  .toolbar{display:flex; align-items:center; justify-content:flex-end; gap:15px; flex-wrap:wrap; margin:6px 2px 16px}\n  .legend{display:flex; gap:16px; color:#8fb6a8; font-size:13px; flex-wrap:wrap; align-items:center}\n  .legend span{display:flex; align-items:center; gap:6px}\n  .lamp{width:11px; height:11px; border-radius:50%}\n  .lamp.gruen{background:var(--gruen)} .lamp.gelb{background:var(--gelb)} .lamp.rot{background:var(--rot)}\n\n  .err{background:#7f1d1d; color:#fee2e2; padding:10px 14px; border-radius:10px; font-size:13px; margin-bottom:16px; display:none}\n\n  .grid{display:grid; grid-template-columns:repeat(auto-fill,minmax(380px,1fr)); gap:18px}\n  .card{background:var(--panel); border-radius:var(--r-card); overflow:hidden; box-shadow:var(--shadow);\n    border:1px solid rgba(255,255,255,.06); display:flex; flex-direction:column; animation:rise .42s var(--ease) both;\n    animation-delay:calc(var(--i,0) * 45ms)}\n  @keyframes rise{from{opacity:0; transform:translateY(14px)}to{opacity:1; transform:none}}\n  .card .bar{height:5px}\n  .card .bar.gruen{background:var(--gruen)} .card .bar.gelb{background:var(--gelb)} .card .bar.rot{background:var(--rot)}\n  .card-head{display:flex; align-items:center; gap:14px; padding:17px 19px 11px}\n  .biglamp{width:36px; height:36px; border-radius:50%; flex:0 0 auto; position:relative}\n  .biglamp::after{content:\"\"; position:absolute; inset:7px 7px auto auto; width:9px; height:9px; border-radius:50%; background:rgba(255,255,255,.6)}\n  .biglamp.gruen{background:var(--gruen)} .biglamp.gelb{background:var(--gelb)} .biglamp.rot{background:var(--rot)}\n  .doc{min-width:0}\n  .doc .p{font-weight:600; font-size:17px; letter-spacing:-.2px; line-height:1.25}\n  .doc .f{font-weight:500; color:var(--muted); font-size:13px; margin-top:2px}\n  .src{margin-left:auto; align-self:flex-start; font-size:11px; font-weight:700; letter-spacing:.4px; padding:4px 10px; border-radius:7px}\n  .src.llm{background:#f5f3ff; color:#6d28d9} .src.csv{background:#eef2ff; color:#4338ca}\n\n  .section{padding:5px 19px}\n  .section h4{margin:11px 0 7px; font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:.6px; display:flex; align-items:center; gap:7px}\n  .read h4{color:#6d28d9}\n  .calc{background:var(--panel-2); margin-top:5px} .calc h4{color:#0e7490}\n  .row{display:flex; justify-content:space-between; gap:14px; padding:7px 0; font-size:14px; border-bottom:1px solid #eef1f5}\n  .row:last-child{border-bottom:0}\n  .row .k{color:var(--muted)} .row .v{font-weight:600; text-align:right; color:var(--ink-2)}\n  .count{font-variant-numeric:tabular-nums}\n  .v.rot{color:var(--rot)} .v.gelb{color:var(--gelb)} .v.gruen{color:var(--gruen)}\n  .pill{display:inline-block; padding:3px 11px; border-radius:999px; font-weight:700; font-size:12.5px; letter-spacing:.3px}\n  .pill.gruen{background:var(--gruen-bg); color:var(--gruen)} .pill.gelb{background:var(--gelb-bg); color:var(--gelb)} .pill.rot{background:var(--rot-bg); color:var(--rot)}\n\n  .foot{display:flex; align-items:center; gap:10px; padding:14px 19px; margin-top:auto; border-top:1px solid var(--line); background:var(--green-bg)}\n  .foot .chk{display:inline-flex; align-items:center; justify-content:center; width:22px; height:22px; border-radius:50%; background:#d1fae5; color:var(--green); font-size:12px}\n  .foot .t{color:var(--green); font-weight:600; font-size:13.5px}\n\n  .empty{color:#9ec8ba; padding:46px 30px; text-align:center; font-size:14.5px; line-height:1.6;\n    background:rgba(255,255,255,.03); border:1px dashed rgba(255,255,255,.12); border-radius:var(--r-card)}\n  footer{color:#6f9486; font-size:12px; text-align:center; line-height:1.7; margin-top:28px}\n</style>\n</head>\n<body>\n<div class=\"wrap\">\n  <header>\n    <div>\n      <span class=\"badge\"><span class=\"lock\">🔒</span> Externe Ansicht · nur freigegebene Meldungen</span>\n      <h1>Fristen-Übersicht</h1>\n      <div class=\"sub\">Diese Ansicht zeigt <b>ausschließlich Meldungen, die ein Mensch freigegeben hat</b>. Was intern noch in Prüfung ist, erscheint hier nicht. Alles läuft <b>lokal</b>.</div>\n    </div>\n    <div class=\"status\">\n      <span class=\"live\"><span class=\"dot\"></span> live</span>\n      <span><span class=\"k\">Freigegeben</span> <b id=\"count\">–</b></span>\n      <span><span class=\"k\">Stand</span> <b id=\"updated\">–</b></span>\n    </div>\n  </header>\n\n  <div class=\"toolbar\">\n    <div class=\"legend\">\n      <span><i class=\"lamp gruen\"></i> grün · im Vorlauf</span>\n      <span><i class=\"lamp gelb\"></i> gelb · Vorwarnung läuft</span>\n      <span><i class=\"lamp rot\"></i> rot · Handlung nötig</span>\n    </div>\n  </div>\n\n  <div id=\"err\" class=\"err\"></div>\n  <div id=\"grid\" class=\"grid\"></div>\n\n  <footer>\n    Daten aus Postgres über lokalen n8n-Webhook · nur freigegebene Einträge · Aktualisierung alle 2,5&nbsp;s · kein Cloud-Dienst beteiligt.\n  </footer>\n</div>\n\n<script>\n  const API = '/webhook/extern-data';\n  const grid = document.getElementById('grid'), errBox = document.getElementById('err');\n\n  const pad = n => String(n).padStart(2, '0');\n  const isTrue = v => v === true || v === 't' || v === 'true' || v === 1;\n  const fmtDate = v => { if(!v) return '–'; const s = String(v).slice(0,10); const m = s.match(/^(\\d{4})-(\\d{2})-(\\d{2})$/); return m ? `${m[3]}.${m[2]}.${m[1]}` : s; };\n  const fmtDT = v => { if(!v) return '–'; const d = new Date(v); if(isNaN(d.getTime())) return String(v); return `${pad(d.getDate())}.${pad(d.getMonth()+1)}. ${pad(d.getHours())}:${pad(d.getMinutes())}`; };\n  const restWarn = n => { n = Number(n); if(n > 0) return `in ${n} Tagen`; if(n === 0) return 'heute'; return `seit ${Math.abs(n)} Tagen offen`; };\n  const restStich = n => { n = Number(n); return n >= 0 ? `in ${n} Tagen` : `vor ${Math.abs(n)} Tagen`; };\n  const esc = s => String(s ?? '').replace(/[&<>\"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]));\n\n  function card(r, i){\n    const a = (r.ampel || 'gruen').toLowerCase();\n    const sm = (r.source_mode || '').toLowerCase();\n    return `\n    <div class=\"card\" style=\"--i:${i}\">\n      <div class=\"bar ${a}\"></div>\n      <div class=\"card-head\">\n        <div class=\"biglamp ${a}\"></div>\n        <div class=\"doc\"><div class=\"p\">${esc(r.partner)}</div><div class=\"f\">${esc(r.doc_name)}</div></div>\n        <div class=\"src ${sm}\">${esc(sm.toUpperCase())}</div>\n      </div>\n      <div class=\"section read\">\n        <h4>${sm === 'csv' ? '📄 Eingelesen · Quelle CSV' : '🧠 Gelesen · von der KI'}</h4>\n        <div class=\"row\"><span class=\"k\">Pflicht</span><span class=\"v\">${esc(r.pflicht)}</span></div>\n        <div class=\"row\"><span class=\"k\">Vertragspartner</span><span class=\"v\">${esc(r.partner)}</span></div>\n        <div class=\"row\"><span class=\"k\">Stichtag</span><span class=\"v\">${fmtDate(r.stichtag)}</span></div>\n        <div class=\"row\"><span class=\"k\">Vorlauf</span><span class=\"v\">${esc(r.vorlauf_tage)} Tage</span></div>\n      </div>\n      <div class=\"section calc\">\n        <h4>⚙️ Berechnet · deterministisch, ohne KI</h4>\n        <div class=\"row\"><span class=\"k\">Warndatum</span><span class=\"v\">${fmtDate(r.warndatum)}</span></div>\n        <div class=\"row\"><span class=\"k\">Vorwarnung</span><span class=\"v count ${a}\">${restWarn(r.resttage)}</span></div>\n        <div class=\"row\"><span class=\"k\">Stichtag</span><span class=\"v count\">${restStich(r.resttage_stichtag)}</span></div>\n        <div class=\"row\"><span class=\"k\">Ampel</span><span class=\"v\"><span class=\"pill ${a}\">${a.toUpperCase()}</span></span></div>\n        <div class=\"row\"><span class=\"k\">Eskalationsstufe</span><span class=\"v\">${({0:'0 — im Vorlauf',1:'1 — Vorwarnung',2:'2 — Eskalation'})[r.eskalationsstufe] ?? esc(r.eskalationsstufe)}</span></div>\n      </div>\n      <div class=\"foot\"><span class=\"chk\">✓</span><span class=\"t\">Freigegeben${r.approved_at ? ' · ' + fmtDT(r.approved_at) : ''}</span></div>\n    </div>`;\n  }\n\n  // Leerer Body (n8n liefert bei 0 freigegebenen Zeilen 0 Bytes statt \"[]\") robust als [] behandeln,\n  // damit der „leeren Start\"-Zustand sauber rendert (kein JSON-Fehler) — wichtig für den Reveal (Szene 7).\n  async function readRows(res){ const t = await res.text(); let r = t ? JSON.parse(t) : []; return Array.isArray(r) ? r : (r ? [r] : []); }\n\n  async function tick(){\n    try{\n      const res = await fetch(API, {cache:'no-store'});\n      if(!res.ok) throw new Error('HTTP ' + res.status);\n      const rows = await readRows(res);\n      errBox.style.display = 'none';\n      document.getElementById('count').textContent = rows.length;\n      const maxApp = rows.reduce((m, r) => (r.approved_at && r.approved_at > m) ? r.approved_at : m, '');\n      document.getElementById('updated').textContent = maxApp ? fmtDT(maxApp) : '–';\n      grid.innerHTML = rows.length\n        ? rows.map(card).join('')\n        : '<div class=\"empty\">Noch nichts freigegeben.<br>Sobald im internen Dashboard ein Mensch eine Meldung <b>freigibt</b>, erscheint sie hier.</div>';\n    }catch(e){ errBox.style.display = 'block'; errBox.textContent = 'Keine Verbindung zum Daten-Webhook (' + e.message + ') — läuft der Dashboard-Server-Workflow?'; }\n  }\n\n  tick();\n  setInterval(tick, 2500);\n</script>\n</body>\n</html>\n",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "text/html; charset=utf-8"
              }
            ]
          }
        }
      }
    }
  ],
  "connections": {
