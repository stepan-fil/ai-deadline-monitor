# ============================================================
#  Konfig-Vorlage für den Fristenwächter-Stack
#  ------------------------------------------------------------
#  KOPIEREN nach ".env" und Werte setzen:   cp .env.example .env
#  Die echte ".env" wird NICHT committet (siehe .gitignore).
#  Diese Datei enthält nur Platzhalter — KEINE echten Secrets.
# ============================================================

# --- Postgres (Datenbank für das Audit-Log) ---
POSTGRES_USER=fristenwaechter
POSTGRES_PASSWORD=bitte_lokales_passwort_setzen
POSTGRES_DB=fristenwaechter

# --- n8n ---
# Encryption-Key: beliebiger langer Zufallsstring. Erzeugen z. B. mit:
#   openssl rand -hex 24
N8N_ENCRYPTION_KEY=bitte_zufallsstring_einsetzen
N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Europe/Berlin

# --- Ollama (lokales LLM, läuft NATIV auf dem Mac) ---
# n8n (im Container) erreicht das native Ollama über host.docker.internal.
# Nur ändern, falls Ollama doch im Container läuft → dann http://ollama:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Modell für den LLM-Pfad. Wird per `ollama pull` gezogen (SETUP.md) UND zur BAUZEIT aus dieser
# .env in die Workflows geschrieben (build_workflows.mjs, ENTSCHEIDUNG-23/-24). Modellwechsel:
# Wert hier ändern → `node n8n/build_workflows.mjs` neu laufen → Workflows neu importieren.
#   16 GB+ RAM:              llama3.1:8b  oder  qwen2.5:7b   (gut bei Deutsch + JSON)
#   knappe HW (z. B. 8 GB):  llama3.2:3b  oder  qwen2.5:3b   ← Default des Build-Macs (ENTSCHEIDUNG-17)
OLLAMA_MODEL=llama3.2:3b

# --- Lokaler Test-Mailserver (GreenMail) für den Mail-Eingang (ENTSCHEIDUNG-28) ---
# REINE DEMO-ZUGANGSDATEN für ein LOKALES Postfach — kein echtes Konto, nichts verlässt den Rechner.
# Diese Werte definieren das Demo-Postfach im GreenMail-Container und werden zum Senden der
# Test-Mail (testdata/send_test_mail.py) sowie für das n8n-IMAP-Credential benutzt.
# IMAP-Login in n8n: User = MAIL_USER, Passwort = MAIL_PASS, Host = greenmail, Port = 3143, TLS aus.
MAIL_USER=fristen
MAIL_PASS=demo_mail_passwort_lokal
MAIL_DOMAIN=fristenwaechter.local
